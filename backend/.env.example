# =============================================================================
# SaaS Microservices Platform — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Connection Strings (one per service database)
# Format: Host=localhost;Port=5432;Database=<db>;Username=<user>;Password=<pass>
# -----------------------------------------------------------------------------
ConnectionStrings__Identity=Host=localhost;Port=5432;Database=identity;Username=saas_admin;Password=saas_password
ConnectionStrings__Tenant=Host=localhost;Port=5432;Database=tenant;Username=saas_admin;Password=saas_password
ConnectionStrings__Order=Host=localhost;Port=5432;Database=order;Username=saas_admin;Password=saas_password
ConnectionStrings__Payment=Host=localhost;Port=5432;Database=payment;Username=saas_admin;Password=saas_password
ConnectionStrings__Inventory=Host=localhost;Port=5432;Database=inventory;Username=saas_admin;Password=saas_password
ConnectionStrings__Customer=Host=localhost;Port=5432;Database=customer;Username=saas_admin;Password=saas_password
ConnectionStrings__Notification=Host=localhost;Port=5432;Database=notification;Username=saas_admin;Password=saas_password

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RabbitMq__Host=amqp://localhost:5672
RabbitMq__Username=saas
RabbitMq__Password=saas

# -----------------------------------------------------------------------------
# JWT / Identity Provider
# -----------------------------------------------------------------------------
# URL of the external IdP JWKS endpoint (e.g., Keycloak, Auth0)
Jwt__Authority=https://your-idp.example.com/.well-known/jwks.json

# -----------------------------------------------------------------------------
# OpenTelemetry / Observability
# -----------------------------------------------------------------------------
Otlp__Endpoint=http://localhost:4317

# -----------------------------------------------------------------------------
# Optional extras used by local Docker Compose
# -----------------------------------------------------------------------------
POSTGRES_USER=saas_admin
POSTGRES_PASSWORD=saas_password
POSTGRES_DB=postgres
RABBITMQ_DEFAULT_USER=saas
RABBITMQ_DEFAULT_PASS=saas
ACCEPT_EULA=Y
