{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "",
    "Audience": ""
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRegex": "^/api/identity(/.*)?$",
            "PathRegexReplacement": "/api$1"
          }
        ]
      },
      "tenant": {
        "ClusterId": "tenant",
        "Match": {
          "Path": "/api/tenant/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRegex": "^/api/tenant(/.*)?$",
            "PathRegexReplacement": "/api/tenants$1"
          }
        ]
      },
      "order": {
        "ClusterId": "order",
        "Match": {
          "Path": "/api/order/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRegex": "^/api/order(/.*)?$",
            "PathRegexReplacement": "/api/orders$1"
          }
        ]
      },
      "customer": {
        "ClusterId": "customer",
        "Match": {
          "Path": "/api/customer/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRegex": "^/api/customer(/.*)?$",
            "PathRegexReplacement": "/api/customers$1"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity": {
            "Address": ""
          }
        }
      },
      "tenant": {
        "Destinations": {
          "tenant": {
            "Address": ""
          }
        }
      },
      "order": {
        "Destinations": {
          "order": {
            "Address": ""
          }
        }
      },
      "customer": {
        "Destinations": {
          "customer": {
            "Address": ""
          }
        }
      }
    }
  }
}
